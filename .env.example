# Copy to .env.local and fill in. .env.local is gitignored.

# --------------------------------------------------------------------------
# Spotify Web API (Client Credentials flow)
# --------------------------------------------------------------------------
# Server-side only — never prefix with NEXT_PUBLIC_.
# Register an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Artist id (the path segment in https://open.spotify.com/artist/<id>).
SPOTIFY_ARTIST_ID=64XV9aZxwoLuxf9tgvu9Pb

# --------------------------------------------------------------------------
# SoundCloud API (OAuth 2.1 Client Credentials)
# --------------------------------------------------------------------------
# Server-side only — never prefix with NEXT_PUBLIC_.
# Register an app at https://developers.soundcloud.com/docs/api/register-app
# Both are required for the live API path; without them, the EPK falls back
# to scraping the public profile page's hydration JSON.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# --------------------------------------------------------------------------
# Instagram Graph API (Instagram Login flow)
# --------------------------------------------------------------------------
# Long-lived (~60 day) access token for the @wompbass account.
# The account must be a Business or Creator account on Instagram.
# Register a Meta app at https://developers.facebook.com/apps (Business type)
# and add the "Instagram" product to generate this token.
# Without the token, the Instagram stat tiles render '—' instead of breaking.
# Server-side only — never prefix with NEXT_PUBLIC_.
INSTAGRAM_ACCESS_TOKEN=

# Optional: one-time OAuth to mint INSTAGRAM_ACCESS_TOKEN (see README).
# Instagram App ID + Secret from App Dashboard → Instagram → Business login settings.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match an OAuth redirect URI in the dashboard exactly, e.g.:
# http://localhost:3000/api/instagram/callback
INSTAGRAM_OAUTH_REDIRECT_URI=
# Set to true only while running the setup flow; leave unset in production.
INSTAGRAM_ENABLE_OAUTH_SETUP=

# --------------------------------------------------------------------------
# Instagram token auto-refresh + health monitoring (production — see README)
# --------------------------------------------------------------------------
# Two crons (vercel.json): a weekly refresh that rotates the token before it
# can expire, and a daily health check that verifies the live API, stores a
# last-known-good stats snapshot, and alerts if the refresh cron stalls.
# Not needed for local dev.
#
# Global Config (formerly "Edge Config") connection string, auto-added when
# you connect a store to this project in the Vercel dashboard (Storage tab ->
# Connect Store). Depending on when you connect it, Vercel may inject this as
# GLOBAL_CONFIG or EDGE_CONFIG — the @vercel/global-config SDK checks both by
# default, so either is fine. Don't set this by hand.
GLOBAL_CONFIG=
# The Edge Config store's id (ecfg_...), used by the crons to write the
# refreshed token and the stats snapshot via the Vercel REST API.
EDGE_CONFIG_ID=
# Vercel API token with write access to the Edge Config store above. Scope it
# to this project so a leak can't touch anything else:
#   vercel tokens add "womp instagram cron" --project prj_...
VERCEL_API_TOKEN=
# Only needed if the token is NOT project-scoped (scoped tokens infer it).
VERCEL_TEAM_ID=
# Random secret Vercel sends back as `Authorization: Bearer <this>` on
# cron-triggered requests. Required in production: without it, the cron
# endpoints refuse to run rather than being publicly callable.
CRON_SECRET=
# Discord webhook URL (Server Settings → Integrations → Webhooks) that
# receives an alert if refresh or the health check ever fails, so you know to
# rotate the token manually via /api/instagram/oauth.
DISCORD_ALERT_WEBHOOK_URL=
# Optional but recommended: a healthchecks.io-style ping URL. The daily health
# check pings it only on a fully clean run, so the external service alerts you
# if the crons stop running entirely (a rollback or dropped vercel.json would
# otherwise silently disable all of the monitoring above).
HEALTHCHECK_PING_URL=

# --------------------------------------------------------------------------
# Download gates (/gate/<slug> + /admin/gates)
# --------------------------------------------------------------------------
# Recommended: Neon via Vercel → Storage → Create → Neon. The integration
# injects both of these automatically in production (DATABASE_URL is the
# pooled endpoint; DATABASE_URL_UNPOOLED is the direct one). Locally,
# `vercel env pull .env.local`, or paste the pooled string by hand.
# Without DATABASE_URL, gate pages 404 and the rest of the site is unaffected.
# Apply the schema with `npm run db:migrate`, then `npm run db:check`.
DATABASE_URL=
# Optional. Neon's Vercel integration sets this automatically. Migrations
# prefer it (DDL is what a transaction-mode pooler handles worst) and fall
# back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Secret used to encrypt the fan session cookie and sign the OAuth `state`
# parameter. Generate with: openssl rand -base64 32
# Required in production; outside production a dev default is used.
GATE_SESSION_SECRET=
# Optional: give admin sessions their own key. Defaults to GATE_SESSION_SECRET,
# which is safe because keys are derived per-purpose.
ADMIN_SESSION_SECRET=

# The single OAuth callback registered on your SoundCloud app, e.g.
#   https://djwomp.com/api/soundcloud/callback
# SoundCloud allows exactly ONE redirect URI per app (edit it at
# https://soundcloud.com/you/apps). Because of that, local development cannot
# use the real flow while production owns the URI — use GATE_MOCK_SOUNDCLOUD
# below, or ask SoundCloud support for a second credential set.
# Registering an app also requires a SoundCloud Artist Pro subscription.
SOUNDCLOUD_OAUTH_REDIRECT_URI=

# Local development only: stub SoundCloud entirely. "Connect" mints a fake fan
# session and the like/repost/comment/follow calls are no-ops, so the whole gate
# flow is clickable without credentials. Ignored when NODE_ENV=production.
GATE_MOCK_SOUNDCLOUD=

# Vercel Blob, for gated files uploaded through the admin UI. Auto-injected
# when you connect a Blob store to the project. Without it you can still attach
# a download URL you host yourself.
BLOB_READ_WRITE_TOKEN=

# One-time: creates the first admin account via /admin/login. Remove both once
# you have signed in — the bootstrap route refuses to run after an account
# exists. Password must be at least 12 characters.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Shown on /privacy as the contact for data access and deletion requests. The
# SoundCloud API terms require a privacy policy; without this the page points
# people at the homepage links instead.
PRIVACY_CONTACT_EMAIL=

# --------------------------------------------------------------------------
# Optional integrations / overrides
# --------------------------------------------------------------------------
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Override the hero image URL (defaults to /assets/hero.jpg).
NEXT_PUBLIC_HERO_IMAGE_URL=
# Bump when you replace public/assets/hero.jpg during local dev (clears cache).
# On Vercel, VERCEL_DEPLOYMENT_ID is used when this is unset.
NEXT_PUBLIC_HERO_IMAGE_REVISION=
